# Copy this file to .env and fill in the values. Never commit .env.

# Required in every environment. Startup fails if it is missing. Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Use True for local development only. Defaults to False.
DJANGO_DEBUG=True

# Comma-separated host names the backend may serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Required. OpenRouteService API key (free tier), used for geocoding. Kept on the backend
# only. Startup fails if it is missing.
ORS_API_KEY=

# Valhalla server used for truck routing. Defaults to the public FOSSGIS server.
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de

# Required. Analysis requests allowed per client, such as 10/minute or 100/hour.
# Startup fails if it is missing or invalid.
ANALYZE_RATE_LIMIT=10/minute

# Optional. Open-Meteo forecasts are requested from the public API by default; leave these
# unset for local development. A deployment can route them through a proxy (for example a
# Cloudflare Worker): set the proxy's https URL, and the token the proxy expects. The token is
# sent only to the proxy, in the X-Proxy-Token header, never to Open-Meteo itself.
# OPEN_METEO_BASE_URL=https://your-weather-proxy.example.workers.dev
# OPEN_METEO_PROXY_TOKEN=
