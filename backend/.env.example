# Copy this file to .env and fill in the values. Never commit .env.

# Required when DJANGO_DEBUG is off. Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Use True for local development only. Defaults to False.
DJANGO_DEBUG=True

# Comma-separated host names the backend may serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# OpenRouteService API key (free tier), used for geocoding. Kept on the backend only.
ORS_API_KEY=

# Valhalla server used for truck routing. Defaults to the public FOSSGIS server.
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de
