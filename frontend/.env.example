# Copy this file to .env. Never commit .env.
# Values prefixed with VITE_ are bundled into the public JavaScript: never put secrets here.

# Required. Base URL of the Django backend (no trailing slash). The backend must allow this
# app's origin in CORS_ALLOWED_ORIGINS (for local development, http://localhost:5173).
VITE_API_BASE_URL=http://127.0.0.1:8000
